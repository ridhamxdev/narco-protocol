# ── NARCO PROTOCOL · environment ─────────────────────────────
# Copy to .env and fill in. Never commit .env.

# MongoDB connection string (MongoDB Atlas free tier works great)
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/narco-protocol
MONGODB_URI=

# Secret used to sign JWT auth tokens — set a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Secret protecting the /api/cron/tick endpoint (email scheduler on Vercel)
CRON_SECRET=change-me-too

# ── Nodemailer (reminder emails) ─────────────────────────────
# Gmail: enable 2FA, then create an App Password:
# Google Account → Security → 2-Step Verification → App passwords
SMTP_USER=
SMTP_PASS=
# Optional — custom SMTP instead of Gmail:
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=465

# Local server port
PORT=3000

# Allow new account signups after the first account exists (true/false)
ALLOW_SIGNUP=false
